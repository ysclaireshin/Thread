# Copy this file to .env.local and paste your keys. .env.local is git-ignored,
# so each person supplies their own keys. Without them, the AI features fall
# back gracefully but won't produce live output.

# Anthropic API key — used by the Replay AI summary (Flow).
# Read server-side only by the /api/replay proxy in vite.config.ts.
# Deliberately NOT prefixed with VITE_, so it never reaches the browser bundle.
ANTHROPIC_API_KEY=

# Groq API key — used by Probe and Trace via the /api/chat proxy in vite.config.ts.
# Groq's free tier keeps Probe/Trace working without a paid Anthropic key.
# Also server-side only (no VITE_ prefix). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# ── Optional: Supabase cloud sync ────────────────────────────────────────────
# Leave both blank to run local-only (sync is skipped, the app works fully).
# Set both to sync projects/nodes to a Supabase project. These ARE VITE_-prefixed
# because the anon key is a public client key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Optional: Formspree feedback mirror ──────────────────────────────────────
# Leave blank to skip - the feedback widget still writes to Supabase either way.
# Set to your Formspree form endpoint (https://formspree.io/f/xxxxxxxx) to also
# get each submission emailed to your Formspree inbox, with the visitor's
# optional email set as the reply-to, so you can reply directly.
VITE_FORMSPREE_ENDPOINT=
